OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Smart router: heuristic (keywords/length) picks easy_model vs hard_model per question.
ROUTER_EASY_MODEL=openai/gpt-5.4-nano
ROUTER_HARD_MODEL=openai/gpt-5.4-mini

# ── Memory layer (backend/memory/) ──────────────────────────────────────────
# LLM used for fact extraction + ADD/UPDATE/DELETE/SKIP decisions. Embeddings
# use the same free local model as retrieval (backend/retrieval.py) — no
# OpenRouter embedding cost.
LLM_MODEL=openai/gpt-5.4-nano
CHROMA_PERSIST_PATH=./data/chroma
CHROMA_COLLECTION=memories

# Neo4j AuraDB — free tier at https://neo4j.com/cloud/aura/. Instances pause
# after inactivity (~60s to resume); memory recall degrades gracefully if
# this is unreachable, chat still works.
NEO4J_URI=neo4j+s://your-instance-id.databases.neo4j.io
NEO4J_USERNAME=your-instance-id
NEO4J_PASSWORD=your-instance-password
NEO4J_DATABASE=your-instance-id
